//////////////////////////////////// OPENCODE: TUI CONFIGURATION ///////////////////////////////////

{
    "$schema": "https://opencode.ai/tui.json",
    "scroll_acceleration": {
        "enabled": true
    },
    "keybinds": {
        "app_exit": "ctrl+d",
        "theme_list": "none",
        "sidebar_toggle": "<leader>]",
        "session_export": "none",
        "session_compact": "none",
        "session_child_cycle": "<leader>j",
        "session_child_cycle_reverse": "<leader>k",
        "session_parent": "<leader>p",
        "messages_page_up": "none",
        "messages_page_down": "none",
        "messages_line_up": "none",
        "messages_line_down": "none",
        "messages_half_page_up": "none",
        "messages_half_page_down": "none",
        "messages_first": "home",
        "messages_last": "end",
        "messages_toggle_conceal": "none",
        "model_cycle_recent": "none",
        "model_cycle_recent_reverse": "none",
        "variant_cycle": "ctrl+v",
        "command_list": "<leader>c",
        "input_clear": "none",
        "input_paste": "none",
        "input_newline": "shift+return,ctrl+j",
        "input_move_left": "left",
        "input_move_right": "right",
        "input_select_left": "none",
        "input_select_right": "none",
        "input_select_up": "none",
        "input_select_down": "none",
        "input_select_line_home": "none",
        "input_select_line_end": "none",
        "input_visual_line_home": "ctrl+shift+a",
        "input_visual_line_end": "ctrl+shift+e",
        "input_select_visual_line_home": "none",
        "input_select_visual_line_end": "none",
        "input_select_buffer_home": "none",
        "input_select_buffer_end": "none",
        "input_delete_line": "none",
        "input_backspace": "backspace",
        "input_delete": "delete",
        "input_undo": "ctrl+z",
        "input_redo": "ctrl+shift+z",
        "input_word_forward": "alt+right",
        "input_word_backward": "alt+left",
        "input_select_word_forward": "none",
        "input_select_word_backward": "none",
        "input_delete_word_forward": "none",
        "input_delete_word_backward": "ctrl+w",
        "terminal_suspend": "<leader>z",
        "tips_toggle": "none"
    }
}
