////////////////////////////////// OPENCODE: RUNTIME CONFIGURATION /////////////////////////////////

{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": false,
    "model": "anthropic/claude-sonnet-4-5",
    "small_model": "opencode/claude-haiku-4-5",
    "permission": {
        "bash": { "*": "allow", "rm *": "ask", "rmdir *": "ask", "git *": "deny" },
        "list": "allow"
    },
    // "agent": { "build": { "disable": true }, "plan": { "disable": true } },
    "default_agent": "build",
    "plugin": ["@ex-machina/opencode-anthropic-auth"]
}
