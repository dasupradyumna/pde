################################## GDB: GNU DEBUGGER CONFIGURATION #################################

# Source watcher command
source ~/.config/gdb/watcher.py

# Load any .gdbinit files under ~/projects folder
add-auto-load-safe-path ~/projects

# Disable confirmation prompts
set confirm off
# Set colorful bold prompt
set prompt \n\n\001\033[1;31m\002GBD >> \001\033[0m\002
# Enable debuginfo auto-download
set debuginfod enabled on
# Disable pagination prompts
set pagination off
# Only indicate presence of frame arguments
set print frame-arguments presence
# Display frame source in `frame`, but not in `backtrace`
set print frame-info auto
# Enable pretty printing of structures
set print pretty on
# Display C++ static members
set print static-members on

# Delete breakpoint
define bd
    delete breakpoints $arg0
end

# List all breakpoints
define bls
    info breakpoints
end

# Display current function arguments, local scope variables, and watcher expressions
define state
    printf "\n-------------------- FUNCTION ARGUMENTS --------------------\n"
    info args
    printf "-------------------- LOCAL VARIABLES -----------------------\n"
    info locals
    watcher ls
    printf "------------------------------------------------------------\n"
end

# Show current frame state after the following commands
define hook-stop
    state
end
define hookpost-frame
    state
end
