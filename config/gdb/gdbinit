# Delete breakpoint
define bd
    delete breakpoints $arg0
end

# List all breakpoints
define bls
    info breakpoints
end

# Display current function arguments and local scope variables
# - Customized to dereference `this` argument (inside class methods)
define state
    printf "\n-------------------- FUNCTION ARGUMENTS --------------------\n"
    info args
    printf "-------------------- LOCAL VARIABLES -----------------------\n"
    info locals
    watcher ls
    printf "------------------------------------------------------------\n"
end

# Show current frame state after the following commands
define hook-stop
    state
end
define hookpost-frame
    state
end
